&НаКлиенте
Перем ФП Экспорт;	
	
&НаКлиенте
Процедура ПриОткрытии(Отказ)

 	Попытка
	    ФП = Новый COMОбъект("AddIn.fptr10");
	Исключение
	    Сообщить("Ошибка создания COM‑объекта: " + ОписаниеОшибки());
	КонецПопытки;
	
	ЭтаФорма.КомПорт = "COM4";
	
КонецПроцедуры

&НаКлиенте
Процедура ХОтчет(Команда)
	
	ФП.open(); 
		ФП.setParam(ФП.LIBFPTR_PARAM_REPORT_TYPE, ФП.LIBFPTR_RT_X);
    	Ответ=ФП.report();
	ФП.close();

КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьСмену(Команда)

	ФП.open(); 
	
		ФП.setParam(ФП.LIBFPTR_PARAM_REPORT_TYPE, ФП.LIBFPTR_RT_CLOSE_SHIFT);
    	Ответ=ФП.report();
		
	ФП.close();

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьСмену(Команда)
	
	ФП.open();
		
		ФП.setParam(1021, СокрЛП(ЭтаФорма.Кассир));  
		Ответ = ФП.operatorLogin();
		Если Ответ <> 0 Тогда
		    Сообщить("Ошибка авторизации: " + ФП.ErrorDescription());
		    ФП.close();
		    Возврат;
		КонецЕсли;

		Ответ = ФП.openShift();
		Если Ответ <> 0 Тогда
		    Сообщить("Ошибка открытия смены: " + ФП.ErrorDescription());
		Иначе
		    Сообщить("Смена открыта успешно!");
		КонецЕсли;

	ФП.close();

КонецПроцедуры

&НаКлиенте
Процедура ПробитьЧек(Команда)
	
	ФП.open(); 
	
		ФП.SetParam(1021, СокрЛП(ЭтаФорма.Кассир));  
		ФП.OperatorLogin();
		
		ФП.SetParam(ФП.LIBFPTR_PARAM_RECEIPT_TYPE, ФП.LIBFPTR_RT_SELL);
		
		Ответ	= ФП.OpenReceipt();
		
		Если Ответ<>0 Тогда
			 Сообщить("Ошибка пробития чека: " + ФП.ErrorDescription());
			 Возврат;
		КонецЕсли;
		
		   			
			Для Каждого Стр11 ИЗ Объект.ТаблицаТоваров Цикл
			
				ФП.SetParam(ФП.LIBFPTR_PARAM_COMMODITY_NAME, 	СокрЛП(Стр11.Номенклатура));    
			    ФП.SetParam(ФП.LIBFPTR_PARAM_QUANTITY, 			Формат(Стр11.Количество,"ЧДЦ=0; ЧРД=.; ЧГ=0"));             
			    ФП.SetParam(ФП.LIBFPTR_PARAM_PRICE, 			Формат(Стр11.Цена,"ЧДЦ=2; ЧРД=.; ЧГ=0"));          		
			    ФП.SetParam(ФП.LIBFPTR_PARAM_TAX_TYPE, 			ФП.LIBFPTR_TAX_NO);  
				ФП.SetParam(ФП.LIBFPTR_PARAM_MEASUREMENT_UNIT, 	ФП.LIBFPTR_IU_PIECE); 
				ФП.SetParam(1212, 1); //1212	Признак предмета расчета
				ФП.SetParam(1214, 4); //1214	Признак способа расчета
				
				ФП.Registration();  // регистрируем позицию
			
			КонецЦикла;
			
		    // Закрываем чек
			
			Если ЭтаФорма.Безналичный = Истина Тогда
				ФП.SetParam(ФП.LIBFPTR_PARAM_PAYMENT_TYPE, ФП.LIBFPTR_PT_ELECTRONICALLY);
            Иначе	
				ФП.SetParam(ФП.LIBFPTR_PARAM_PAYMENT_TYPE, ФП.LIBFPTR_PT_CASH);
			КонецЕсли;
			
			ФП.SetParam(ФП.LIBFPTR_PARAM_SUM, Формат(Объект.ТаблицаТоваров.Итог("Сумма"),"ЧДЦ=2; ЧРД=.; ЧГ=0"));
			
	    ФП.CloseReceipt();
	    
	    // Проверяем результат
	    Если ФП.ErrorCode() = 0 Тогда
	        Сообщить("Чек пробит успешно!");
	    Иначе
	        Сообщить("Ошибка пробития чека: " + ФП.ErrorDescription());
	    КонецЕсли;
    
    // Закрываем соединение
    ФП.Close();
	
	
КонецПроцедуры

&НаКлиенте
Процедура ПрименитьНастройку(Команда)
	
	ФП.setSingleSetting(ФП.LIBFPTR_SETTING_MODEL, Строка(ФП.LIBFPTR_MODEL_ATOL_AUTO));
    ФП.setSingleSetting(ФП.LIBFPTR_SETTING_PORT, Строка(ФП.LIBFPTR_PORT_COM));
    ФП.setSingleSetting(ФП.LIBFPTR_SETTING_COM_FILE, СокрЛП(ЭтаФорма.КомПорт));
    ФП.setSingleSetting(ФП.LIBFPTR_SETTING_BAUDRATE, Строка(ФП.LIBFPTR_PORT_BR_115200));
    ФП.applySingleSettings();

КонецПроцедуры

&НаКлиенте
Процедура ТаблицаТоваровЦенаПриИзменении(Элемент)
	
	СтрокаТабличнойЧасти 	= Неопределено;
	ИмяТабличнойЧасти 		= "ТаблицаТоваров";
	
	Если СтрокаТабличнойЧасти = Неопределено Тогда
		СтрокаТабличнойЧасти = Элементы[ИмяТабличнойЧасти].ТекущиеДанные;
	КонецЕсли; 
	
	СтрокаТабличнойЧасти.Сумма = СтрокаТабличнойЧасти.Цена*СтрокаТабличнойЧасти.Количество;

КонецПроцедуры

&НаКлиенте
Процедура ТаблицаТоваровКоличествоПриИзменении(Элемент)
	
	СтрокаТабличнойЧасти 	= Неопределено;
	ИмяТабличнойЧасти 		= "ТаблицаТоваров";
	
	Если СтрокаТабличнойЧасти = Неопределено Тогда
		СтрокаТабличнойЧасти = Элементы[ИмяТабличнойЧасти].ТекущиеДанные;
	КонецЕсли;
	
	СтрокаТабличнойЧасти.Сумма = СтрокаТабличнойЧасти.Цена*СтрокаТабличнойЧасти.Количество;	

КонецПроцедуры     











