&НаКлиенте
Перем ФП Экспорт;
	
&НаКлиенте
Процедура ПриОткрытии(Отказ)

 	Попытка
	    ФП = Новый COMОбъект("AddIn.fptr10");
	Исключение
	    Сообщить("Ошибка создания COM‑объекта: " + ОписаниеОшибки());
		Отказ = Истина;
	    Возврат;
	КонецПопытки;
	
	// Подключение к ККТ по TCP/IP (Ethernet / Wi-Fi)
	Если ПустаяСтрока(ЭтаФорма.АдресККТ) Тогда
		ЭтаФорма.АдресККТ = "192.168.1.100";
	КонецЕсли;
	
	Если ПустаяСтрока(ЭтаФорма.ПортККТ) Тогда
		ЭтаФорма.ПортККТ = "7778"; // порт по умолчанию для ККТ АТОЛ
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ХОтчет(Команда)
	
	ФП.open(); 
		ФП.setParam(ФП.LIBFPTR_PARAM_REPORT_TYPE, ФП.LIBFPTR_RT_X);
    	Ответ=ФП.report();
	ФП.close();

КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьСмену(Команда)

	ФП.open(); 
	
		ФП.setParam(ФП.LIBFPTR_PARAM_REPORT_TYPE, ФП.LIBFPTR_RT_CLOSE_SHIFT);
    	Ответ=ФП.report();
		
	ФП.close();

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьСмену(Команда)
	
	ФП.open();
		
		ФП.setParam(1021, СокрЛП(ЭтаФорма.Кассир));  
		Ответ = ФП.operatorLogin();
		Если Ответ <> 0 Тогда
		    Сообщить("Ошибка авторизации: " + ФП.ErrorDescription());
		    ФП.close();
		    Возврат;
		КонецЕсли;

		Ответ = ФП.openShift();
		Если Ответ <> 0 Тогда
		    Сообщить("Ошибка открытия смены: " + ФП.ErrorDescription());
		Иначе
		    Сообщить("Смена открыта успешно!");
		КонецЕсли;

	ФП.close();

КонецПроцедуры

&НаКлиенте
Процедура ПробитьЧек(Команда)
	
	ФП.open(); 
	
		ФП.SetParam(1021, СокрЛП(ЭтаФорма.Кассир));  
		Ответ = ФП.OperatorLogin();
		Если Ответ <> 0 Тогда
			Сообщить("Ошибка авторизации: " + ФП.ErrorDescription());
			ФП.Close();
			Возврат;
		КонецЕсли;
		
		// Проверяем КМ маркированных товаров (Честный знак) до открытия чека - ФФД 1.2
		РезультатыПроверкиКМ = Новый Соответствие; // КМ -> результат онлайн-проверки (тег 2106)
		Для Каждого Стр11 ИЗ Объект.ТаблицаТоваров Цикл
			КМ = СокрЛП(Стр11.КодМаркировки);
			Если НЕ ПустаяСтрока(КМ) 
				И РезультатыПроверкиКМ.Получить(КМ) = Неопределено Тогда
				
				РезультатПроверки = ПроверитьКМ(КМ);
				Если РезультатПроверки = Неопределено Тогда
					// КМ не проверен - отмена проверки и чека
					ФП.cancelMarkingCodeValidation();
					ФП.Close();
					Возврат;
				КонецЕсли;
				РезультатыПроверкиКМ.Вставить(КМ, РезультатПроверки);
			КонецЕсли;
		КонецЦикла;
		
		ФП.SetParam(ФП.LIBFPTR_PARAM_RECEIPT_TYPE, ФП.LIBFPTR_RT_SELL);
		
		Ответ	= ФП.OpenReceipt();
		
		Если Ответ<>0 Тогда
			 Сообщить("Ошибка пробития чека: " + ФП.ErrorDescription());
			 ФП.Close();
			 Возврат;
		КонецЕсли;
		
		   			
			Для Каждого Стр11 ИЗ Объект.ТаблицаТоваров Цикл
			
				ФП.SetParam(ФП.LIBFPTR_PARAM_COMMODITY_NAME, 	СокрЛП(Стр11.Номенклатура));    
			    ФП.SetParam(ФП.LIBFPTR_PARAM_QUANTITY, 			Формат(Стр11.Количество,"ЧДЦ=0; ЧРД=.; ЧГ=0"));             
			    ФП.SetParam(ФП.LIBFPTR_PARAM_PRICE, 			Формат(Стр11.Цена,"ЧДЦ=2; ЧРД=.; ЧГ=0"));          		
			    ФП.SetParam(ФП.LIBFPTR_PARAM_TAX_TYPE, 			ФП.LIBFPTR_TAX_NO);  
				ФП.SetParam(ФП.LIBFPTR_PARAM_MEASUREMENT_UNIT, 	ФП.LIBFPTR_IU_PIECE); 
				ФП.SetParam(1212, 1); //1212	Признак предмета расчета
				ФП.SetParam(1214, 4); //1214	Признак способа расчета
				
				КМ = СокрЛП(Стр11.КодМаркировки);
				Если НЕ ПустаяСтрока(КМ) Тогда
					// Маркированный товар (Честный знак), ФФД 1.2
					ФП.SetParam(ФП.LIBFPTR_PARAM_MARKING_CODE, КМ);                       // 2000 - код маркировки
					ФП.SetParam(ФП.LIBFPTR_PARAM_MARKING_CODE_TYPE, ФП.LIBFPTR_MCT12_AUTO); // 2100 - тип КМ (автоопределение)
					ФП.SetParam(ФП.LIBFPTR_PARAM_MARKING_CODE_STATUS, ФП.LIBFPTR_MES_PIECE_SOLD); // 2003 - штучный товар, реализован
					ФП.SetParam(ФП.LIBFPTR_PARAM_MARKING_CODE_ONLINE_VALIDATION_RESULT, РезультатыПроверкиКМ.Получить(КМ)); // 2106 - результат онлайн-проверки
					ФП.SetParam(ФП.LIBFPTR_PARAM_MARKING_PROCESSING_MODE, 0);            // 2102 - режим обработки кода товара
				КонецЕсли;
				
				ФП.Registration();  // регистрируем позицию
			
			КонецЦикла;
			
		    // Закрываем чек
			
			Если ЭтаФорма.Безналичный = Истина Тогда
				ФП.SetParam(ФП.LIBFPTR_PARAM_PAYMENT_TYPE, ФП.LIBFPTR_PT_ELECTRONICALLY);
            Иначе	
				ФП.SetParam(ФП.LIBFPTR_PARAM_PAYMENT_TYPE, ФП.LIBFPTR_PT_CASH);
			КонецЕсли;
			
			ФП.SetParam(ФП.LIBFPTR_PARAM_SUM, Формат(Объект.ТаблицаТоваров.Итог("Сумма"),"ЧДЦ=2; ЧРД=.; ЧГ=0"));
			
	    ФП.CloseReceipt();
	    
	    // Проверяем результат
	    Если ФП.ErrorCode() = 0 Тогда
	        Сообщить("Чек пробит успешно!");
	    Иначе
	        Сообщить("Ошибка пробития чека: " + ФП.ErrorDescription());
	    КонецЕсли;
    
    // Закрываем соединение
    ФП.Close();
	
	
КонецПроцедуры

&НаКлиенте
Функция ПроверитьКМ(КМ)
	
	// Проверка кода маркировки в ИС МП (Честный знак) - ФФД 1.2.
	// Синхронный режим: задан ненулевой таймаут LIBFPTR_PARAM_TIMEOUT (требуется ККТ >= 5.10.X)
	ФП.SetParam(ФП.LIBFPTR_PARAM_MARKING_CODE_TYPE, ФП.LIBFPTR_MCT12_AUTO);        // 2100 - тип КМ (автоопределение)
	ФП.SetParam(ФП.LIBFPTR_PARAM_MARKING_CODE, КМ);                               // 2000 - код маркировки
	ФП.SetParam(ФП.LIBFPTR_PARAM_MARKING_CODE_STATUS, ФП.LIBFPTR_MES_PIECE_SOLD); // 2003 - штучный товар, реализован
	ФП.SetParam(ФП.LIBFPTR_PARAM_QUANTITY, Формат(1, "ЧДЦ=3; ЧРД=.; ЧГ=0"));      // 1023 - количество
	ФП.SetParam(ФП.LIBFPTR_PARAM_MEASUREMENT_UNIT, ФП.LIBFPTR_IU_PIECE);          // 2108 - мера количества
	ФП.SetParam(ФП.LIBFPTR_PARAM_MARKING_PROCESSING_MODE, 0);                     // 2102 - режим обработки кода товара
	ФП.SetParam(ФП.LIBFPTR_PARAM_TIMEOUT, 60000);                                 // синхронный режим, таймаут 60 сек
	
	Если ФП.beginMarkingCodeValidation() <> 0 Тогда
		Сообщить("Ошибка проверки КМ [" + КМ + "]: " + ФП.ErrorDescription());
		Возврат Неопределено;
	КонецЕсли;
	
	// Ожидаем завершение онлайн-проверки
	ФП.getMarkingCodeValidationStatus();
	Пока ФП.getParamBool(ФП.LIBFPTR_PARAM_MARKING_CODE_VALIDATION_READY) = Ложь Цикл
		ФП.getMarkingCodeValidationStatus();
	КонецЦикла;
	
	// Результат онлайн-проверки (тег 2106) запоминается и подается при регистрации позиции
	РезультатОнлайнПроверки = ФП.getParamInt(ФП.LIBFPTR_PARAM_MARKING_CODE_ONLINE_VALIDATION_RESULT);
	
	// Подтверждаем реализацию товара с данным КМ
	ФП.acceptMarkingCode();
	
	Возврат РезультатОнлайнПроверки;
	
КонецФункции

&НаКлиенте
Процедура ПрименитьНастройку(Команда)
	
	Если ПустаяСтрока(ЭтаФорма.АдресККТ) Тогда
		Сообщить("Не указан IP-адрес ККТ!");
		Возврат;
	КонецЕсли;
	
	// Связь с ККТ по TCP/IP: LIBFPTR_PORT_TCPIP + адрес и порт ККТ
	ФП.setSingleSetting(ФП.LIBFPTR_SETTING_MODEL,    Строка(ФП.LIBFPTR_MODEL_ATOL_AUTO));
    ФП.setSingleSetting(ФП.LIBFPTR_SETTING_PORT,    Строка(ФП.LIBFPTR_PORT_TCPIP));
    ФП.setSingleSetting(ФП.LIBFPTR_SETTING_IPADDRESS, СокрЛП(ЭтаФорма.АдресККТ));
    ФП.setSingleSetting(ФП.LIBFPTR_SETTING_IPPORT,  СокрЛП(ЭтаФорма.ПортККТ));
    ФП.applySingleSettings();
	
	// Проверяем соединение
	ФП.open();
	Если ФП.isOpened() Тогда
		Сообщить("Связь с ККТ установлена: " + СокрЛП(ЭтаФорма.АдресККТ) + ":" + СокрЛП(ЭтаФорма.ПортККТ));
	Иначе
		Сообщить("Ошибка связи с ККТ: " + ФП.ErrorDescription());
	КонецЕсли;
	ФП.close();

КонецПроцедуры

&НаКлиенте
Процедура ТаблицаТоваровЦенаПриИзменении(Элемент)
	
	СтрокаТабличнойЧасти 	= Неопределено;
	ИмяТабличнойЧасти 		= "ТаблицаТоваров";
	
	Если СтрокаТабличнойЧасти = Неопределено Тогда
		СтрокаТабличнойЧасти = Элементы[ИмяТабличнойЧасти].ТекущиеДанные;
	КонецЕсли; 
	
	СтрокаТабличнойЧасти.Сумма = СтрокаТабличнойЧасти.Цена*СтрокаТабличнойЧасти.Количество;

КонецПроцедуры

&НаКлиенте
Процедура ТаблицаТоваровКоличествоПриИзменении(Элемент)
	
	СтрокаТабличнойЧасти 	= Неопределено;
	ИмяТабличнойЧасти 		= "ТаблицаТоваров";
	
	Если СтрокаТабличнойЧасти = Неопределено Тогда
		СтрокаТабличнойЧасти = Элементы[ИмяТабличнойЧасти].ТекущиеДанные;
	КонецЕсли;
	
	СтрокаТабличнойЧасти.Сумма = СтрокаТабличнойЧасти.Цена*СтрокаТабличнойЧасти.Количество;	

КонецПроцедуры     
