&НаКлиенте
Перем ФП Экспорт;

&НаКлиенте
Перем НастройкиПрименены;

#Область Служебные

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	НастройкиПрименены = Ложь;

	Попытка
		ФП = Новый COMОбъект("AddIn.fptr10");
	Исключение
		Сообщить("Ошибка создания COM-объекта: " + ОписаниеОшибки());
	КонецПопытки;

	// Стандартный порт ККТ АТОЛ по TCP/IP - 5555 (уточните в настройках кассы)
	Если ЭтаФорма.ПортККТ = 0 Тогда
		ЭтаФорма.ПортККТ = 5555;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура АдресККТПриИзменении(Элемент)
	НастройкиПрименены = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура ПортККТПриИзменении(Элемент)
	НастройкиПрименены = Ложь;
КонецПроцедуры

&НаКлиенте
Функция ДрайверГотов()

	Если ФП = Неопределено Тогда
		Сообщить("Драйвер ККТ (AddIn.fptr10) не создан. Проверьте, что драйвер установлен и зарегистрирован.");
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции

&НаКлиенте
Функция ОшибкаККТ()
	Возврат "[" + XMLСтрока(ФП.errorCode()) + "] " + ФП.errorDescription();
КонецФункции

// Передает драйверу настройки соединения по TCP/IP.
&НаКлиенте
Функция ПрименитьНастройкиСоединения()

	Если Не ДрайверГотов() Тогда
		Возврат Ложь;
	КонецЕсли;

	Если ПустаяСтрока(СокрЛП(ЭтаФорма.АдресККТ)) Тогда
		Сообщить("Не указан IP-адрес (или имя хоста) кассы.");
		Возврат Ложь;
	КонецЕсли;

	Если ЭтаФорма.ПортККТ <= 0 Или ЭтаФорма.ПортККТ > 65535 Тогда
		Сообщить("Некорректный TCP-порт кассы.");
		Возврат Ложь;
	КонецЕсли;

	// Настройки нельзя менять при открытом соединении
	Если ФП.isOpened() Тогда
		ФП.close();
	КонецЕсли;

	// Числа передаем через XMLСтрока(): Строка() вставила бы разделители разрядов ("5 555")
	ФП.setSingleSetting(ФП.LIBFPTR_SETTING_MODEL, XMLСтрока(ФП.LIBFPTR_MODEL_ATOL_AUTO));
	ФП.setSingleSetting(ФП.LIBFPTR_SETTING_PORT, XMLСтрока(ФП.LIBFPTR_PORT_TCPIP));
	ФП.setSingleSetting(ФП.LIBFPTR_SETTING_IPADDRESS, СокрЛП(ЭтаФорма.АдресККТ));
	ФП.setSingleSetting(ФП.LIBFPTR_SETTING_IPPORT, XMLСтрока(ЭтаФорма.ПортККТ));

	Если ФП.applySingleSettings() <> 0 Тогда
		Сообщить("Ошибка применения настроек: " + ОшибкаККТ());
		Возврат Ложь;
	КонецЕсли;

	НастройкиПрименены = Истина;
	Возврат Истина;

КонецФункции

// Применяет настройки (если нужно) и открывает соединение с ККТ.
// После успешного вызова обязательно вызвать ФП.close().
&НаКлиенте
Функция ОткрытьСоединение()

	Если Не ДрайверГотов() Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Не НастройкиПрименены Тогда
		Если Не ПрименитьНастройкиСоединения() Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;

	ФП.open();

	Если Не ФП.isOpened() Тогда
		Сообщить("Нет связи с ККТ " + СокрЛП(ЭтаФорма.АдресККТ) + ":" + XMLСтрока(ЭтаФорма.ПортККТ)
			+ ": " + ОшибкаККТ());
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции

&НаКлиенте
Функция ВойтиКассиром(Обязательно = Истина)

	ИмяКассира = СокрЛП(ЭтаФорма.Кассир);

	Если ПустаяСтрока(ИмяКассира) Тогда
		Если Обязательно Тогда
			Сообщить("Не указан кассир.");
			Возврат Ложь;
		КонецЕсли;
		Возврат Истина;
	КонецЕсли;

	ФП.setParam(1021, ИмяКассира);

	Если ФП.operatorLogin() <> 0 Тогда
		Сообщить("Ошибка авторизации кассира: " + ОшибкаККТ());
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции

// Проверка итога фискальной операции (смена, чек). По TCP/IP связь может оборваться
// в момент закрытия документа, поэтому итог всегда сверяем с состоянием ККТ.
&НаКлиенте
Функция ПроверитьЗакрытиеДокумента(ЭтоЧек = Ложь)

	МаксПопыток = 3;

	Для НомерПопытки = 1 По МаксПопыток Цикл

		Если ФП.checkDocumentClosed() = 0 Тогда
			Прервать;
		КонецЕсли;

		Если НомерПопытки = МаксПопыток Тогда
			Сообщить("Не удалось проверить закрытие документа: " + ОшибкаККТ()
				+ ". Проверьте связь и состояние документа на кассе, прежде чем повторять операцию.");
			Возврат Ложь;
		КонецЕсли;

	КонецЦикла;

	Если Не ФП.getParamBool(ФП.LIBFPTR_PARAM_DOCUMENT_CLOSED) Тогда
		Если ЭтоЧек Тогда
			ФП.cancelReceipt();
		КонецЕсли;
		Сообщить("Документ не был закрыт на кассе." + ?(ЭтоЧек, " Чек отменен, пробейте его заново.", ""));
		Возврат Ложь;
	КонецЕсли;

	Если Не ФП.getParamBool(ФП.LIBFPTR_PARAM_DOCUMENT_PRINTED) Тогда
		Если ФП.continuePrint() <> 0 Тогда
			Сообщить("Документ закрыт, но не допечатан: " + ОшибкаККТ());
		КонецЕсли;
	КонецЕсли;

	Возврат Истина;

КонецФункции

// Таймаут проверки КМ, мс. >0 - синхронный режим (ККТ с прошивкой от 5.10),
// 0 - асинхронный режим (подходит для любых ККТ, ожидание результата выполняется в цикле).
&НаКлиенте
Функция ТаймаутПроверкиКМ()
	Возврат 120000;
КонецФункции

// Часовая зона для уведомления о реализации маркированного товара (реквизит 1011).
// LIBFPTR_TIME_ZONE_2 - UTC+3. Для другой зоны замените константу.
&НаКлиенте
Функция ЧасоваяЗонаУведомления()
	Возврат ФП.LIBFPTR_TIME_ZONE_2;
КонецФункции

// Отмена чека. Заодно драйвер очищает свою внутреннюю таблицу проверенных КМ.
// Если чек не открыт, ККТ вернет ошибку - она здесь не важна.
&НаКлиенте
Процедура ОтменитьЧек()
	ФП.cancelReceipt();
КонецПроцедуры

// Проверка строк таблицы до обращения к кассе.
&НаКлиенте
Функция ПроверитьСтрокиТаблицы()

	НайденныеКМ = Новый Соответствие;

	Для Каждого СтрокаТовара Из Объект.ТаблицаТоваров Цикл

		Если ПустаяСтрока(СтрокаТовара.КодМаркировки) Тогда
			Продолжить;
		КонецЕсли;

		Если СтрокаТовара.Количество <> 1 Тогда
			Сообщить("Строка " + XMLСтрока(СтрокаТовара.НомерСтроки)
				+ ": один код маркировки - одна строка, количество должно быть равно 1.");
			Возврат Ложь;
		КонецЕсли;

		Если НайденныеКМ[СтрокаТовара.КодМаркировки] <> Неопределено Тогда
			Сообщить("Строка " + XMLСтрока(СтрокаТовара.НомерСтроки) + ": этот код маркировки уже есть в чеке.");
			Возврат Ложь;
		КонецЕсли;

		НайденныеКМ.Вставить(СтрокаТовара.КодМаркировки, Истина);

	КонецЦикла;

	Возврат Истина;

КонецФункции

// Проверка и подтверждение реализации одного КМ (ФФД 1.2). Вызывается ДО открытия чека.
// Возвращает структуру с данными для регистрации позиции или Неопределено, если продавать нельзя.
&НаКлиенте
Функция ПроверитьКМ(КодМаркировки)

	Таймаут = ТаймаутПроверкиКМ();

	ФП.setParam(ФП.LIBFPTR_PARAM_MARKING_CODE_TYPE, ФП.LIBFPTR_MCT12_AUTO);
	ФП.setParam(ФП.LIBFPTR_PARAM_MARKING_CODE, КодМаркировки);
	ФП.setParam(ФП.LIBFPTR_PARAM_MARKING_CODE_STATUS, ФП.LIBFPTR_MES_PIECE_SOLD);
	ФП.setParam(ФП.LIBFPTR_PARAM_QUANTITY, 1);
	ФП.setParam(ФП.LIBFPTR_PARAM_MEASUREMENT_UNIT, ФП.LIBFPTR_IU_PIECE);
	ФП.setParam(ФП.LIBFPTR_PARAM_MARKING_PROCESSING_MODE, 0);

	Если Таймаут > 0 Тогда
		ФП.setParam(ФП.LIBFPTR_PARAM_TIMEOUT, Таймаут);
	КонецЕсли;

	// В синхронном режиме вызов блокируется до ответа ИСМ или таймаута
	Если ФП.beginMarkingCodeValidation() <> 0 Тогда
		Сообщить("Ошибка начала проверки КМ: " + ОшибкаККТ());
		ФП.cancelMarkingCodeValidation();
		Возврат Неопределено;
	КонецЕсли;

	Если Таймаут > 0 Тогда

		// Результат нужно запросить обязательно, иначе КМ нельзя будет подтвердить или отклонить
		Если ФП.getMarkingCodeValidationStatus() <> 0 Тогда
			Сообщить("Ошибка получения результата проверки КМ: " + ОшибкаККТ());
			ФП.cancelMarkingCodeValidation();
			Возврат Неопределено;
		КонецЕсли;

	Иначе

		НачалоОжидания = ТекущаяДата();

		Пока Истина Цикл

			Если ФП.getMarkingCodeValidationStatus() <> 0 Тогда
				Сообщить("Ошибка получения результата проверки КМ: " + ОшибкаККТ());
				ФП.cancelMarkingCodeValidation();
				Возврат Неопределено;
			КонецЕсли;

			Если ФП.getParamBool(ФП.LIBFPTR_PARAM_MARKING_CODE_VALIDATION_READY) Тогда
				Прервать;
			КонецЕсли;

			Если ТекущаяДата() - НачалоОжидания > 120 Тогда
				Сообщить("Истекло время ожидания ответа на проверку КМ.");
				ФП.cancelMarkingCodeValidation();
				Возврат Неопределено;
			КонецЕсли;

		КонецЦикла;

	КонецЕсли;

	Если Не ФП.getParamBool(ФП.LIBFPTR_PARAM_MARKING_CODE_VALIDATION_READY) Тогда
		Сообщить("Проверка КМ не завершена за отведенное время.");
		ФП.cancelMarkingCodeValidation();
		Возврат Неопределено;
	КонецЕсли;

	// Ошибка онлайн-проверки (нет связи с ИСМ и т.п.)
	КодОшибкиИСМ = ФП.getParamInt(ФП.LIBFPTR_PARAM_MARKING_CODE_ONLINE_VALIDATION_ERROR);

	Если КодОшибкиИСМ <> 0 Тогда
		Сообщить("Ошибка онлайн-проверки КМ: [" + XMLСтрока(КодОшибкиИСМ) + "] "
			+ ФП.getParamString(ФП.LIBFPTR_PARAM_MARKING_CODE_ONLINE_VALIDATION_ERROR_DESCRIPTION));
		ФП.cancelMarkingCodeValidation();
		Возврат Неопределено;
	КонецЕсли;

	РезультатыПроверки = Новый Структура("РезультатПроверки, ТипКМ, ИдентификаторТовара", 0, Неопределено, Неопределено);
	РезультатыПроверки.РезультатПроверки = ФП.getParamInt(ФП.LIBFPTR_PARAM_MARKING_CODE_ONLINE_VALIDATION_RESULT);

	// Эти реквизиты сервер ИСМ возвращает не всегда
	Если ФП.isParamAvailable(2100) Тогда
		РезультатыПроверки.ТипКМ = ФП.getParamInt(2100);
	КонецЕсли;

	Если ФП.isParamAvailable(2101) Тогда
		РезультатыПроверки.ИдентификаторТовара = ФП.getParamString(2101);
	КонецЕсли;

	// Реквизит 2106 = 15: КМ проверен, результат положительный, статус ИСМ получен и корректен
	Если РезультатыПроверки.РезультатПроверки <> 15 Тогда
		ФП.declineMarkingCode();
		Сообщить("КМ не прошел проверку (реквизит 2106 = " + XMLСтрока(РезультатыПроверки.РезультатПроверки)
			+ ", ожидается 15). Реализация отклонена.");
		Возврат Неопределено;
	КонецЕсли;

	Если ФП.acceptMarkingCode() <> 0 Тогда
		Сообщить("Ошибка подтверждения реализации КМ: " + ОшибкаККТ());
		ФП.cancelMarkingCodeValidation();
		Возврат Неопределено;
	КонецЕсли;

	Возврат РезультатыПроверки;

КонецФункции

// Перед закрытием чека убеждаемся, что все КМ отправлены.
&НаКлиенте
Функция ДождатьсяОтправкиКМ()

	НачалоОжидания = ТекущаяДата();

	Пока Истина Цикл

		Если ФП.checkMarkingCodeValidationsReady() <> 0 Тогда
			Сообщить("Ошибка проверки состояния КМ: " + ОшибкаККТ());
			Возврат Ложь;
		КонецЕсли;

		Если ФП.getParamBool(ФП.LIBFPTR_PARAM_MARKING_CODE_VALIDATION_READY) Тогда
			Возврат Истина;
		КонецЕсли;

		Если ТекущаяДата() - НачалоОжидания > 60 Тогда
			Сообщить("Истекло время ожидания отправки КМ.");
			Возврат Ложь;
		КонецЕсли;

	КонецЦикла;

КонецФункции

#КонецОбласти

#Область Команды

&НаКлиенте
Процедура ПрименитьНастройку(Команда)

	Если Не ПрименитьНастройкиСоединения() Тогда
		Возврат;
	КонецЕсли;

	// Заодно проверяем доступность кассы по сети
	Если ОткрытьСоединение() Тогда
		Сообщить("Связь с ККТ установлена: " + СокрЛП(ЭтаФорма.АдресККТ) + ":" + XMLСтрока(ЭтаФорма.ПортККТ));
		ФП.close();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ХОтчет(Команда)

	Если Не ОткрытьСоединение() Тогда
		Возврат;
	КонецЕсли;

	Попытка
		ФП.setParam(ФП.LIBFPTR_PARAM_REPORT_TYPE, ФП.LIBFPTR_RT_X);

		Если ФП.report() <> 0 Тогда
			Сообщить("Ошибка печати X-отчета: " + ОшибкаККТ());
		Иначе
			Сообщить("X-отчет напечатан.");
		КонецЕсли;
	Исключение
		Сообщить("Ошибка при работе с драйвером: " + ОписаниеОшибки());
	КонецПопытки;

	ФП.close();

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьСмену(Команда)

	Если Не ОткрытьСоединение() Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Если ВойтиКассиром() Тогда

			Если ФП.openShift() <> 0 Тогда
				Сообщить("Ошибка открытия смены: " + ОшибкаККТ());
			ИначеЕсли ПроверитьЗакрытиеДокумента() Тогда
				Сообщить("Смена открыта успешно!");
			КонецЕсли;

		КонецЕсли;
	Исключение
		Сообщить("Ошибка при работе с драйвером: " + ОписаниеОшибки());
	КонецПопытки;

	ФП.close();

КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьСмену(Команда)

	Если Не ОткрытьСоединение() Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Если ВойтиКассиром(Ложь) Тогда

			ФП.setParam(ФП.LIBFPTR_PARAM_REPORT_TYPE, ФП.LIBFPTR_RT_CLOSE_SHIFT);

			Если ФП.report() <> 0 Тогда
				Сообщить("Ошибка закрытия смены: " + ОшибкаККТ());
			ИначеЕсли ПроверитьЗакрытиеДокумента() Тогда
				Сообщить("Смена закрыта успешно!");
			КонецЕсли;

		КонецЕсли;
	Исключение
		Сообщить("Ошибка при работе с драйвером: " + ОписаниеОшибки());
	КонецПопытки;

	ФП.close();

КонецПроцедуры

&НаКлиенте
Процедура ПробитьЧек(Команда)

	Если Объект.ТаблицаТоваров.Количество() = 0 Тогда
		Сообщить("Таблица товаров пуста.");
		Возврат;
	КонецЕсли;

	Если Не ПроверитьСтрокиТаблицы() Тогда
		Возврат;
	КонецЕсли;

	Если Не ОткрытьСоединение() Тогда
		Возврат;
	КонецЕсли;

	Попытка
		ПробитьЧекНаКассе();
	Исключение
		Сообщить("Ошибка при работе с драйвером: " + ОписаниеОшибки());
		// Состояние чека неизвестно - пробуем отменить незакрытый чек
		ОтменитьЧек();
	КонецПопытки;

	ФП.close();

КонецПроцедуры

// Формирует и закрывает чек продажи (в том числе с маркированными товарами). Соединение уже открыто.
&НаКлиенте
Процедура ПробитьЧекНаКассе()

	Если Не ВойтиКассиром() Тогда
		Возврат;
	КонецЕсли;

	// 1. Маркированные товары (ФФД 1.2): КМ проверяются и подтверждаются ДО открытия чека
	РезультатыКМ = Новый Соответствие;

	Для Каждого СтрокаТовара Из Объект.ТаблицаТоваров Цикл

		Если ПустаяСтрока(СтрокаТовара.КодМаркировки) Тогда
			Продолжить;
		КонецЕсли;

		РезультатКМ = ПроверитьКМ(СтрокаТовара.КодМаркировки);

		Если РезультатКМ = Неопределено Тогда
			Сообщить("Чек не пробит: КМ в строке " + XMLСтрока(СтрокаТовара.НомерСтроки) + " не прошел проверку.");
			ОтменитьЧек(); // сбрасываем уже принятые КМ в таблице драйвера
			Возврат;
		КонецЕсли;

		РезультатыКМ.Вставить(СтрокаТовара.КодМаркировки, РезультатКМ);

	КонецЦикла;

	ЕстьМаркированные = РезультатыКМ.Количество() > 0;

	// 2. Открываем чек
	ФП.setParam(ФП.LIBFPTR_PARAM_RECEIPT_TYPE, ФП.LIBFPTR_RT_SELL);

	Если ФП.openReceipt() <> 0 Тогда
		Сообщить("Ошибка открытия чека: " + ОшибкаККТ());
		ОтменитьЧек();
		Возврат;
	КонецЕсли;

	// 3. Регистрируем позиции
	ИтогЧека = 0;

	Для Каждого СтрокаТовара Из Объект.ТаблицаТоваров Цикл

		ФП.setParam(ФП.LIBFPTR_PARAM_COMMODITY_NAME, СокрЛП(СтрокаТовара.Номенклатура));
		ФП.setParam(ФП.LIBFPTR_PARAM_PRICE, Окр(СтрокаТовара.Цена, 2));
		ФП.setParam(ФП.LIBFPTR_PARAM_QUANTITY, Окр(СтрокаТовара.Количество, 3));
		ФП.setParam(ФП.LIBFPTR_PARAM_TAX_TYPE, ФП.LIBFPTR_TAX_NO);
		ФП.setParam(ФП.LIBFPTR_PARAM_MEASUREMENT_UNIT, ФП.LIBFPTR_IU_PIECE);
		ФП.setParam(1214, 4); // Признак способа расчета

		РезультатКМ = РезультатыКМ[СтрокаТовара.КодМаркировки];

		Если РезультатКМ = Неопределено Тогда

			ФП.setParam(1212, 1); // Признак предмета расчета: товар

		Иначе

			ФП.setParam(1212, 33); // Товар, подлежащий маркировке, с кодом маркировки
			ФП.setParam(ФП.LIBFPTR_PARAM_MARKING_CODE, СтрокаТовара.КодМаркировки);
			ФП.setParam(ФП.LIBFPTR_PARAM_MARKING_CODE_STATUS, ФП.LIBFPTR_MES_PIECE_SOLD);
			ФП.setParam(ФП.LIBFPTR_PARAM_MARKING_CODE_ONLINE_VALIDATION_RESULT, РезультатКМ.РезультатПроверки);
			ФП.setParam(ФП.LIBFPTR_PARAM_MARKING_PROCESSING_MODE, 0);

			// Если ИСМ вернул уточненный тип КМ и идентификатор товара - передаем их
			Если РезультатКМ.ТипКМ <> Неопределено Тогда
				ФП.setParam(ФП.LIBFPTR_PARAM_MARKING_CODE_TYPE, РезультатКМ.ТипКМ);
			КонецЕсли;

			Если РезультатКМ.ИдентификаторТовара <> Неопределено Тогда
				ФП.setParam(ФП.LIBFPTR_PARAM_MARKING_PRODUCT_ID, РезультатКМ.ИдентификаторТовара);
			КонецЕсли;

		КонецЕсли;

		Если ФП.registration() <> 0 Тогда
			Сообщить("Ошибка регистрации позиции """ + СокрЛП(СтрокаТовара.Номенклатура) + """: " + ОшибкаККТ());
			ОтменитьЧек();
			Возврат;
		КонецЕсли;

		ИтогЧека = ИтогЧека + Окр(СтрокаТовара.Цена * СтрокаТовара.Количество, 2);

	КонецЦикла;

	// 4. Уведомление о реализации маркированного товара: после всех позиций и до оплаты
	Если ЕстьМаркированные Тогда

		ФП.setParam(1011, ЧасоваяЗонаУведомления());

		Если ФП.writeSalesNotice() <> 0 Тогда
			Сообщить("Ошибка передачи уведомления о реализации: " + ОшибкаККТ());
			ОтменитьЧек();
			Возврат;
		КонецЕсли;

	КонецЕсли;

	// 5. Итог и оплата
	ФП.setParam(ФП.LIBFPTR_PARAM_SUM, ИтогЧека);

	Если ФП.receiptTotal() <> 0 Тогда
		Сообщить("Ошибка регистрации итога чека: " + ОшибкаККТ());
		ОтменитьЧек();
		Возврат;
	КонецЕсли;

	Если ЭтаФорма.Безналичный Тогда
		ФП.setParam(ФП.LIBFPTR_PARAM_PAYMENT_TYPE, ФП.LIBFPTR_PT_ELECTRONICALLY);
	Иначе
		ФП.setParam(ФП.LIBFPTR_PARAM_PAYMENT_TYPE, ФП.LIBFPTR_PT_CASH);
	КонецЕсли;

	ФП.setParam(ФП.LIBFPTR_PARAM_PAYMENT_SUM, ИтогЧека);

	Если ФП.payment() <> 0 Тогда
		Сообщить("Ошибка регистрации оплаты: " + ОшибкаККТ());
		ОтменитьЧек();
		Возврат;
	КонецЕсли;

	// 6. Перед закрытием проверяем, что все КМ отправлены
	Если ЕстьМаркированные Тогда
		Если Не ДождатьсяОтправкиКМ() Тогда
			ОтменитьЧек();
			Возврат;
		КонецЕсли;
	КонецЕсли;

	// 7. Закрываем чек
	Если ФП.closeReceipt() <> 0 Тогда
		// Возможен обрыв связи в момент закрытия - итог выясняем по состоянию документа
		Сообщить("Ошибка закрытия чека: " + ОшибкаККТ() + ". Проверяю состояние документа...");
	КонецЕсли;

	Если ПроверитьЗакрытиеДокумента(Истина) Тогда
		Сообщить("Чек пробит успешно!");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ТаблицаТоваров

&НаКлиенте
Процедура ПересчитатьСтроку()

	ТекущаяСтрока = Элементы.ТаблицаТоваров.ТекущиеДанные;

	Если ТекущаяСтрока <> Неопределено Тогда
		ТекущаяСтрока.Сумма = Окр(ТекущаяСтрока.Цена * ТекущаяСтрока.Количество, 2);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ТаблицаТоваровЦенаПриИзменении(Элемент)
	ПересчитатьСтроку();
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаТоваровКоличествоПриИзменении(Элемент)
	ПересчитатьСтроку();
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаТоваровКодМаркировкиПриИзменении(Элемент)

	ТекущаяСтрока = Элементы.ТаблицаТоваров.ТекущиеДанные;

	// Один код маркировки - одна единица товара
	Если ТекущаяСтрока <> Неопределено И Не ПустаяСтрока(ТекущаяСтрока.КодМаркировки) Тогда
		ТекущаяСтрока.Количество = 1;
		ПересчитатьСтроку();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
